# Copia este archivo como ".env" y pon los valores de tu proyecto de Supabase
# (Project Settings -> API). Usa SOLO la clave pública (anon / publishable).
# Nunca pongas aquí la service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica

# URL del backend (solo se usa en el celular; en web las llamadas pasan por el proxy de metro.config.js).
# En el celular (Expo Go) usa la IP de tu PC, p. ej. http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
