SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# Clave de servidor service_role o sb_secret_: el worker escribe en public."Pagos".
# Nunca colocar esta clave en el frontend.
SUPABASE_KEY=SECRET_KEY

RABBITMQ_USER=XXXXXXXX
RABBITMQ_PASSWORD=XXXXXXXX
RABBITMQ_QUEUE=ai_requests
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

OLLAMA_MODEL=gemma4:e4b

RABBITMQ_EVENT_EXCHANGE=domain_events
RABBITMQ_EVENT_DEAD_LETTER_EXCHANGE=domain_events.dlx
RABBITMQ_EVENT_QUEUE=application_events
RABBITMQ_VHOST=/

# ---------- Stripe: pagos de PRUEBA (no mueve dinero real) ----------
# Clave secreta del sandbox de tu cuenta Stripe: empieza por sk_test_.
# Obtener en Dashboard Stripe > API keys. Solo backend; nunca EXPO_PUBLIC_.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook: empieza por whsec_. No es la clave anterior.
# Para desarrollo lo muestra: stripe listen --forward-to localhost:8000/v1/pagos/webhook/stripe
# Para un servidor publico, usar el secreto de SU endpoint en Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# URL del frontend a la que vuelve Stripe al terminar o al cancelar.
# El parametro solo informa de la vuelta; el webhook confirma el pago.
STRIPE_SUCCESS_URL=http://localhost:8081/?stripe_return=success
STRIPE_CANCEL_URL=http://localhost:8081/?stripe_return=cancel
# true habilita pagos TEST con el total del pedido guardado en Supabase.
# Verifica el propietario del pedido. El importe nunca viene del frontend.
# false mantiene bloqueado el cobro mientras no exista una cotizacion definitiva.
PAYMENTS_SANDBOX_FIXTURES=true
# Moneda del total del pedido: pesos colombianos. No convierte COP a otra moneda.
# Stripe recibe unidades menores: un pedido de 15000 COP se envia como 1500000.
PAYMENTS_TEST_CURRENCY=cop
# Registro tecnico persistente. Docker Compose lo fija en /payment-data/journal.sqlite3.
# Fuera de Docker, API y worker deben usar la misma ruta absoluta.
PAYMENTS_JOURNAL_PATH=./.payment-data/journal.sqlite3
